#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layers
//
// ORDER IS LOAD-BEARING. The Toucan2 shield hard-codes these indices:
//   is_touching_processor  bindings = <&mo 4>      -> MOUSE while a finger rests on the trackpad
//   trackpad_listener      scroller layers = <1 2> -> touch-scroll on LOWER / RAISE
//
// Reordering these, or inserting a layer before MOUSE, silently repoints the
// trackpad at the wrong layer: the build still succeeds and the pointer just
// misbehaves. See docs/multi-keyboard-plan.md §5.1.
#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define MOUSE 4

// Behaviors Constants
#define TAPPING_TERM_MS 200
#define QUICK_TAP_MS 175
#define REQUIRE_PRIOR_IDLE_MS 150

#include "./behaviors.dtsi"
#include "./combos.dtsi"
