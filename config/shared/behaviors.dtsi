/ {
    macros {
        capitalize_i: capitalize_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap &kp LS(I) &kp SPACE>;
        };
    };

    behaviors {
        // Home Row Mods
        // See: https://zmk.dev/docs/keymaps/behaviors/hold-tap?examples=home_row_mods#custom-hold-tap-examples
        hml: hml_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: hmr_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Thumb layer-tap: hold for the layer, tap for the key.
        //
        // Not ZMK's stock &lt, which is flavor = "tap-preferred": that only
        // triggers the hold once the tapping term has fully elapsed, so holding
        // the thumb and immediately hitting a key gives you the TAP plus the
        // base-layer key instead of the layer. "hold-preferred" resolves to the
        // hold as soon as another key is pressed, which is what a layer key on a
        // thumb needs. Thumbs rarely roll into neighbours, so the usual argument
        // for "balanced" (used above for the home row) does not apply here.
        //
        // quick-tap-ms forces a second press within the window to resolve as a
        // TAP rather than a hold. That is what lets a held backspace repeat, so
        // it belongs on the Num thumb -- but it is measured from the first press
        // and cannot be scoped to only the case you want, which is why the two
        // thumbs need separate behaviors.
        ltt: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&mo>, <&kp>;
        };

        // Same, minus quick-tap. For a tap key that has no use for auto-repeat
        // (escape), the window is pure cost: it would turn "tap escape, then hold
        // for the layer" into a second escape, blocking the layer until it
        // expires. Omitting quick-tap-ms restores ZMK's default of disabled.
        ltt_norepeat: layer_tap_thumb_norepeat {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&mo>, <&kp>;
        };

        // Hold-to-confirm wrappers for the two destructive keys. A press shorter
        // than a second does nothing at all.
        //
        // "tap-preferred" is the safety property here: unlike the other flavours
        // it resolves to the HOLD only when the full tapping term elapses --
        // pressing any other key in the meantime resolves to the tap instead, so
        // a stray chord can never reboot the board.
        //
        // Wrapping does not change which half reboots. The hold-tap runs on the
        // central but passes event.source through, and zmk_behavior_invoke_binding
        // reads locality from the inner behaviour, which is EVENT_SOURCE.
        //
        // Node names kept <= 8 characters out of caution: that is ZMK's limit for
        // behaviours invoked on a peripheral.
        boot_hold: boothold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&bootloader>, <&none>;
        };

        reset_hold: rsthold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&sys_reset>, <&none>;
        };
    };
};
