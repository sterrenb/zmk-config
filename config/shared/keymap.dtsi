#include "./base.dtsi"
#include "./version.dtsi"
#include <dt-bindings/zmk/keys.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = KEYMAP_VERSION;
                        bindings = <
                                &kp ESC         &kp B           &kp L           &kp D           &kp W           &kp Z           &kp SQT         &kp F           &kp O           &kp U           &kp J           &kp BSPC
                                &kp TAB         &hml LSHFT N    &hml LCTRL R    &hml LALT T     &hml LGUI S     &kp G           &kp Y           &hmr RGUI H     &hmr RALT A     &hmr RCTRL E    &hmr RSHFT I    &kp DQT
                                &kp GRAVE       &kp Q           &kp X           &kp M           &kp C           &kp V           &kp K           &kp P           &kp COMMA       &kp DOT         &kp SEMICOLON   &kp DEL
                                                                                &kp LGUI    &ltt_norepeat NAV ESC   &kp SPACE       &kp RET         &ltt NUM BSPC   &kp TAB
                        >;
                };

                // Held by the LEFT thumb, so everything lives on the RIGHT hand.
                // The left hand stays &trans to keep the home row mods available
                // for Ctrl+arrow, Shift+Home and so on.
                nav_layer {
                        display-name = "Nav";
                        bindings = <
                                &trans          &trans          &trans          &trans          &trans          &trans          &kp LC(Y)       &kp LC(Z)       &kp LC(C)       &kp LC(V)       &kp LC(X)       &trans
                                &trans          &trans          &trans          &trans          &trans          &trans          &kp INS         &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &trans
                                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp HOME        &kp PG_DN       &kp PG_UP       &kp END         &trans
                                                                                &trans          &trans          &trans          &trans          &trans          &trans
                        >;
                };

                // Held by the RIGHT thumb, so everything lives on the LEFT hand.
                // Reading order, not numpad order: 1-2-3 / 4-5-6 / 7-8-9 counting
                // from the top left, with 0 continuing onto the outer thumb. This
                // matches the number row, and it is the only direction that also
                // works for F1-F12 on the Media layer, which has no numpad form.
                // Arithmetic sits in the inner column. Symbols stay on the combos.
                num_layer {
                        display-name = "Num";
                        bindings = <
                                &trans          &trans          &kp N1          &kp N2          &kp N3          &kp PLUS        &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &kp N4          &kp N5          &kp N6          &kp MINUS       &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &kp N7          &kp N8          &kp N9          &kp ASTERISK    &trans          &trans          &trans          &trans          &trans          &trans
                                                                                &kp N0          &trans          &trans          &trans          &trans          &trans
                        >;
                };

                // Reached by holding NAV + NUM together (tri-layer, below).
                // Right hand mirrors the Nav layer's geometry: prev/next sit where
                // left/right are, volume where up/down are, brightness below it.
                // Left hand mirrors the Num layer exactly, so F1-F9 sit on the same
                // keys as 1-9 and the inner column carries F10-F12.
                media_layer {
                        display-name = "Media";
                        bindings = <
                                &trans          &trans          &kp F1          &kp F2          &kp F3          &kp F10         &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_CLR
                                &trans          &trans          &kp F4          &kp F5          &kp F6          &kp F11         &out OUT_TOG    &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT      &kp C_MUTE
                                &trans          &trans          &kp F7          &kp F8          &kp F9          &kp F12         &kp C_PLAY_PAUSE &kp C_AL_LOCK  &kp C_BRI_DN    &kp C_BRI_UP    &sys_reset      &bootloader
                                                                                &trans          &trans          &trans          &trans          &trans          &trans
                        >;
                };

                // Activated by the Toucan2 trackpad while a finger is down, via the
                // shield's is_touching_processor. Unreachable on the Corne by design.
                mouse_layer {
                        display-name = "Mouse";
                        bindings = <
                                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                                                                                &mkp MCLK       &mkp LCLK       &mkp RCLK       &mkp LCLK       &mkp RCLK       &mkp MCLK
                        >;
                };

        };

        conditional_layers {
                compatible = "zmk,conditional-layers";

                tri_layer {
                        if-layers = <NAV NUM>;
                        then-layer = <MEDIA>;
                };
        };
};
