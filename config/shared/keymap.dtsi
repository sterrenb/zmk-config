#include "./base.dtsi"
#include "./version.dtsi"
#include <dt-bindings/zmk/keys.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = KEYMAP_VERSION;
                        bindings = <
                                &kp ESC         &kp B           &kp L           &kp D           &kp W           &kp Z           &kp SQT         &kp F           &kp O           &kp U           &kp J           &kp BSPC
                                &kp TAB         &hml LSHFT N    &hml LCTRL R    &hml LALT T     &hml LGUI S     &kp G           &kp Y           &hmr RGUI H     &hmr RALT A     &hmr RCTRL E    &hmr RSHFT I    &kp DQT
                                &kp GRAVE       &kp Q           &kp X           &kp M           &kp C           &kp V           &kp K           &kp P           &kp COMMA       &kp DOT         &kp SEMICOLON   &kp DEL
                                                                                &kp LGUI    &ltt_norepeat NAV ESC   &kp SPACE       &kp RET         &ltt NUM BSPC   &kp TAB
                        >;
                };

                // Right hand navigates TEXT, left hand navigates the OS.
                //
                // The outer column carries reset (home row) and bootloader (bottom)
                // for THIS half. They live here rather than on Media because Media
                // is a tri-layer needing a thumb on each half: once the right half
                // enters the bootloader it stops scanning and drops its BLE link, so
                // Media becomes unreachable and the left half could no longer be put
                // into the bootloader. Nav needs only the left thumb, so it still
                // works with the right half absent, flat or already flashing.
                //
                // The left HOME ROW must stay &trans -- that is what keeps the home
                // row mods live for Ctrl+arrow, Shift+arrow and Shift+Home, which is
                // the most valuable thing on this layer. Only rows 0 and 2 are free.
                //
                // Row 0 reads left-to-right as the window snaps, matching the order
                // the arrows read on the right hand. Deliberately omits things that
                // are already trivial on base with a home row mod (Ctrl+F, Ctrl+S):
                // these are the chords that are genuinely awkward otherwise.
                nav_layer {
                        display-name = "Nav";
                        bindings = <
                                &trans          &kp LG(LEFT)    &kp LG(DOWN)    &kp LG(UP)      &kp LG(RIGHT)   &kp LA(TAB)     &kp LC(Y)       &kp LC(Z)       &kp LC(C)       &kp LC(V)       &kp LC(X)       &trans
                                &reset_hold 0 0 &trans          &trans          &trans          &trans          &trans          &kp INS         &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &trans
                                &boot_hold 0 0  &kp LA(LEFT)    &kp LA(RIGHT)   &kp LG(TAB)     &kp LG(LS(S))   &kp K_APP       &trans          &kp HOME        &kp PG_DN       &kp PG_UP       &kp END         &trans
                                                                                &trans          &trans          &trans          &trans          &trans          &trans
                        >;
                };

                // Held by the RIGHT thumb, so everything lives on the LEFT hand.
                // Reading order, not numpad order: 1-2-3 / 4-5-6 / 7-8-9 counting
                // from the top left, with 0 continuing onto the outer thumb. This
                // matches the number row, and it is the only direction that also
                // works for F1-F12 on the Media layer, which has no numpad form.
                // Arithmetic sits in the inner column. Symbols stay on the combos.
                //
                // The outer column mirrors Nav: reset on the home row, bootloader
                // below, both acting on the RIGHT half. Nav covers the left half and
                // Num the right, so each is reachable with a single thumb.
                num_layer {
                        display-name = "Num";
                        bindings = <
                                &trans          &trans          &kp N1          &kp N2          &kp N3          &kp PLUS        &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &kp N4          &kp N5          &kp N6          &kp MINUS       &trans          &trans          &trans          &trans          &trans          &reset_hold 0 0
                                &trans          &trans          &kp N7          &kp N8          &kp N9          &kp ASTERISK    &trans          &trans          &trans          &trans          &trans          &boot_hold 0 0
                                                                                &kp N0          &trans          &trans          &trans          &trans          &trans
                        >;
                };

                // Reached by holding NAV + NUM together (tri-layer, below).
                // Right hand mirrors the Nav layer's geometry: prev/next sit where
                // left/right are, volume where up/down are, brightness below it.
                // Left hand mirrors the Num layer exactly, so F1-F9 sit on the same
                // keys as 1-9 and the inner column carries F10-F12.
                //
                // reset/bootloader deliberately do NOT live here -- see the Nav layer
                // comment. This layer needs a thumb on each half, so it is exactly
                // the wrong place for the keys you need when one half is missing.
                media_layer {
                        display-name = "Media";
                        bindings = <
                                &trans          &trans          &kp F1          &kp F2          &kp F3          &kp F10         &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_CLR
                                &trans          &trans          &kp F4          &kp F5          &kp F6          &kp F11         &out OUT_TOG    &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT      &kp C_MUTE
                                &trans          &trans          &kp F7          &kp F8          &kp F9          &kp F12         &kp C_PLAY_PAUSE &kp C_AL_LOCK  &kp C_BRI_DN    &kp C_BRI_UP    &trans          &trans
                                                                                &trans          &trans          &trans          &trans          &trans          &trans
                        >;
                };

                // Activated by the Toucan2 trackpad while a finger is down, via the
                // shield's is_touching_processor. Unreachable on the Corne by design.
                mouse_layer {
                        display-name = "Mouse";
                        bindings = <
                                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                                                                                &mkp MCLK       &mkp LCLK       &mkp RCLK       &mkp LCLK       &mkp RCLK       &mkp MCLK
                        >;
                };

        };

        conditional_layers {
                compatible = "zmk,conditional-layers";

                tri_layer {
                        if-layers = <NAV NUM>;
                        then-layer = <MEDIA>;
                };
        };
};
