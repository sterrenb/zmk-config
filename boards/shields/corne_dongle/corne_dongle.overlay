/*
 * Prospector dongle for the Corne: the split central, with no keys of its own.
 *
 * Deliberately does NOT include ZMK's corne.dtsi. That file is written for the
 * halves and reaches for &pro_micro, &pro_micro_i2c and the SSD1306, none of
 * which exist on a Seeed XIAO BLE. What the central actually needs is only the
 * matrix transform (so key positions coming off the peripherals resolve to the
 * 42 keymap positions) and the physical layout (so ZMK Studio can render it),
 * both copied verbatim from
 * https://github.com/zmkfirmware/zmk/blob/v0.3/app/boards/shields/corne/corne.dtsi
 *
 * The halves report already-global positions -- corne_right.overlay applies
 * col-offset = <6> to this same transform on its own side -- so the dongle
 * needs no offset logic of its own.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/foostan/corne/6column.dtsi>

&foostan_corne_6col_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
// | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
// | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
// | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
//                      | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    // ZMK requires a chosen zmk,kscan even on a device with no matrix.
    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};
